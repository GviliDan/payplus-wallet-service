          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('id matches merchantId variable', function () { pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('merchantId'))); });",
                  "pm.test('response has expected fields', function () {",
                  "  pm.expect(json).to.have.property('name');",
                  "  pm.expect(json).to.have.property('status');",
                  "  pm.expect(json).to.have.property('created_at');",
                  "  pm.expect(json).to.have.property('updated_at');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "List Merchants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants"],
              "query": [
                { "key": "status", "value": "active", "disabled": true },
                { "key": "limit", "value": "20", "disabled": true },
                { "key": "offset", "value": "0", "disabled": true }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response has items array and pagination fields', function () {",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});",
                  "pm.test('created merchant appears in the list', function () {",
                  "  const ids = json.items.map(function (m) { return m.id; });",
                  "  pm.expect(ids).to.include(Number(pm.collectionVariables.get('merchantId')));",
                  "});"
                ]
