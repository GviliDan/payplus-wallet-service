{
  "info": {
    "_postman_id": "7f3b1c2a-9e4d-4a2b-8b1a-payplus000001",
    "name": "PayPlus Wallet API",
    "description": "REST API for the PayPlus wallet transaction service (merchants, wallets, charge/refund transactions, ledger). Requests are designed to run top to bottom, folder by folder (Health -> Merchants -> Wallets -> Transactions -> Ledger -> Idempotency), e.g. via Collection Runner, since later requests reuse ids saved by earlier ones. Several Transactions requests include a pre-request script that re-asserts the merchant/wallet active status they need, so the folder is self-healing even if run more than once.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "merchantId", "value": "", "type": "string" },
    { "key": "walletId", "value": "", "type": "string" },
    { "key": "transactionId", "value": "", "type": "string" },
    { "key": "refundTransactionId", "value": "", "type": "string" },
    { "key": "insufficientFundsWalletId", "value": "", "type": "string" },
    { "key": "chargeClientRequestId", "value": "", "type": "string" },
    { "key": "refundClientRequestId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('status field is ok', function () { pm.expect(json.status).to.eql('ok'); });"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
