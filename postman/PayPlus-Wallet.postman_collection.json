              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "// Charge - Success charged 30.00 and Refund - Success already refunded 10.00,",
                  "// leaving 20.00 refundable; this request asks for 25.00 to trigger the decline.",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'active', function () {});",
