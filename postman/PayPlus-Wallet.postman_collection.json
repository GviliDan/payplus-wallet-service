    {
      "name": "Idempotency",
      "item": [
        {
          "name": "Charge - Retry With Same client_request_id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{walletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"30.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{chargeClientRequestId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Same client_request_id as Charge - Success: this must replay the original",
                  "// transaction, not create a second one.",
                  "pm.test('status code is 200 (idempotent replay, not 201 created)', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('returns the same transaction id as the original charge', function () { pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('transactionId'))); });",
                  "pm.test('transaction status is still succeeded', function () { pm.expect(json.status).to.eql('succeeded'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refund - Retry With Same client_request_id",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "refund"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_transaction_id\": {{transactionId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{refundClientRequestId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
