            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('status updated to inactive', function () { pm.expect(json.status).to.eql('inactive'); });",
                  "// Note: this intentionally leaves merchantId inactive. The Transactions folder",
                  "// re-activates it in pre-request scripts wherever an active merchant is needed."
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
