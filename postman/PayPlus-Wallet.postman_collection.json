          "response": []
        },
        {
          "name": "Get Merchant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/merchants/{{merchantId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "merchants", "{{merchantId}}"]
