    {
      "name": "Transactions",
      "item": [
        {
          "name": "Charge - Success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{walletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"30.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{chargeClientRequestId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "// This is the first Transactions request: make sure the merchant/wallet",
                  "// created earlier are active, regardless of what earlier folders left them as.",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'active', function () {",
                  "    pm.collectionVariables.set('chargeClientRequestId', 'charge-success-' + Date.now() + '-' + Math.random().toString(36).slice(2));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('response has numeric id', function () { pm.expect(typeof json.id).to.eql('number'); });",
                  "pm.test('transaction status is succeeded', function () { pm.expect(json.status).to.eql('succeeded'); });",
                  "pm.test('transaction type is charge', function () { pm.expect(json.type).to.eql('charge'); });",
                  "pm.test('wallet_id matches request', function () { pm.expect(json.wallet_id).to.eql(Number(pm.collectionVariables.get('walletId'))); });",
                  "if (json.id) { pm.collectionVariables.set('transactionId', json.id); }"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Charge - Insufficient Funds",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{insufficientFundsWalletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"120.50\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{$randomUUID}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  // Dedicated low-balance wallet for this decline scenario, created fresh each run",
                  "  // (the Wallets folder only demonstrates creating the main walletId).",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + '/api/wallets',",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ owner_identity: 'emp-low-balance', currency: 'ILS', initial_balance: '50.00' }) }",
                  "  }, function (err, res) {",
                  "    const walletJson = res.json();",
                  "    pm.collectionVariables.set('insufficientFundsWalletId', walletJson.id);",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 409', function () { pm.response.to.have.status(409); });",
                  "const json = pm.response.json();",
                  "pm.test('error code is insufficient_funds', function () { pm.expect(json.error.code).to.eql('insufficient_funds'); });",
                  "pm.test('error envelope has status/message/details', function () {",
                  "  pm.expect(json.error.status).to.eql(409);",
                  "  pm.expect(typeof json.error.message).to.eql('string');",
                  "  pm.expect(json.error.details).to.be.an('object');",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Charge - Inactive Wallet",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{walletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{$randomUUID}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "// merchant must be active so this decline is unambiguously about the wallet",
                  "// (merchant_inactive is checked before wallet_inactive in the service logic).",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'inactive', function () {});",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 409', function () { pm.response.to.have.status(409); });",
                  "const json = pm.response.json();",
                  "pm.test('error code is wallet_inactive', function () { pm.expect(json.error.code).to.eql('wallet_inactive'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Charge - Inactive Merchant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{walletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{$randomUUID}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "// undo the previous request's wallet deactivation, then deactivate the merchant instead.",
                  "setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'active', function () {",
                  "  setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'inactive', function () {});",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 409', function () { pm.response.to.have.status(409); });",
                  "const json = pm.response.json();",
                  "pm.test('error code is merchant_inactive', function () { pm.expect(json.error.code).to.eql('merchant_inactive'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Charge - Currency Mismatch",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "charge"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"wallet_id\": {{walletId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"10.00\",\n  \"currency\": \"USD\",\n  \"client_request_id\": \"{{$randomUUID}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "// undo the previous request's merchant deactivation; walletId (ILS) stays active",
                  "// so this decline is unambiguously about the currency (\"USD\" in the body).",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'active', function () {});",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 409', function () { pm.response.to.have.status(409); });",
                  "const json = pm.response.json();",
                  "pm.test('error code is currency_mismatch', function () { pm.expect(json.error.code).to.eql('currency_mismatch'); });"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "Refund - Success",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/transactions/refund",
              "host": ["{{baseUrl}}"],
              "path": ["api", "transactions", "refund"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"original_transaction_id\": {{transactionId}},\n  \"merchant_id\": {{merchantId}},\n  \"amount\": \"10.00\",\n  \"currency\": \"ILS\",\n  \"client_request_id\": \"{{refundClientRequestId}}\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function setStatus(basePath, id, status, cb) {",
                  "  pm.sendRequest({",
                  "    url: pm.collectionVariables.get('baseUrl') + basePath + id + '/status',",
                  "    method: 'PATCH',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ status: status }) }",
                  "  }, cb);",
                  "}",
                  "setStatus('/api/merchants/', pm.collectionVariables.get('merchantId'), 'active', function () {",
                  "  setStatus('/api/wallets/', pm.collectionVariables.get('walletId'), 'active', function () {",
                  "    pm.collectionVariables.set('refundClientRequestId', 'refund-success-' + Date.now() + '-' + Math.random().toString(36).slice(2));",
                  "  });",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.test('refund status is succeeded', function () { pm.expect(json.status).to.eql('succeeded'); });",
                  "pm.test('refund type is refund', function () { pm.expect(json.type).to.eql('refund'); });",
                  "pm.test('original_transaction_id matches the charge', function () { pm.expect(json.original_transaction_id).to.eql(Number(pm.collectionVariables.get('transactionId'))); });",
                  "if (json.id) { pm.collectionVariables.set('refundTransactionId', json.id); }"
                ]
              }
            }
          ],
          "response": []
        },
