    {
      "name": "Ledger",
      "item": [
        {
          "name": "Get Wallet Ledger",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/wallets/{{walletId}}/ledger-entries",
              "host": ["{{baseUrl}}"],
              "path": ["api", "wallets", "{{walletId}}", "ledger-entries"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status code is 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('response has items array and pagination fields', function () {",
                  "  pm.expect(json.items).to.be.an('array');",
                  "  pm.expect(json).to.have.property('total');",
                  "  pm.expect(json).to.have.property('limit');",
                  "  pm.expect(json).to.have.property('offset');",
                  "});",
                  "pm.test('each entry has the expected shape', function () {",
                  "  json.items.forEach(function (entry) {",
                  "    pm.expect(typeof entry.id).to.eql('number');",
                  "    pm.expect(entry.wallet_id).to.eql(Number(pm.collectionVariables.get('walletId')));",
                  "    pm.expect(['charge', 'refund']).to.include(entry.type);",
                  "  });",
                  "});",
                  "pm.test('exactly one charge entry and one refund entry for this wallet', function () {",
                  "  const types = json.items.map(function (item) { return item.type; });",
                  "  pm.expect(types.filter(function (t) { return t === 'charge'; }).length).to.eql(1);",
                  "  pm.expect(types.filter(function (t) { return t === 'refund'; }).length).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "response": []
        },
